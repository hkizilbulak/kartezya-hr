# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kartezya_hr
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_HOURS=24

# Server Configuration
SERVER_PORT=8080
GIN_MODE=debug
DB_TABLE_PREFIX=hr_test

# Application Configuration
APP_NAME=Kartezya HR
APP_VERSION=1.0.0

SMTP_HOST="smtp.yandex.com.tr"
SMTP_USER="hrportal@kartezya.com"
SMTP_PORT="587"
SMTP_PASSWORD="..."
FROM_EMAIL="hrportal@kartezya.com"
FROM_NAME="Kartezya HR"
FRONTEND_URL="http://localhost:3000"

# OAuth Configuration
YANDEX_CLIENT_ID=eff28f055726491d86b6d64bbbbdc484
YANDEX_CLIENT_SECRET=....
YANDEX_REDIRECT_URL=http://localhost:8080/api/v1/auth/yandex/callback

# Storage Configuration (Document Management System)
STORAGE_PROVIDER=local              # Options: local, s3, backblaze, azure

# Local Storage (only for STORAGE_PROVIDER=local)
STORAGE_BASE_PATH=./uploads         # Local storage base directory
STORAGE_BASE_URL=http://localhost:8080  # Base URL for generating file access URLs

# S3-Compatible Storage (AWS S3, Backblaze B2, MinIO, etc.)
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com  # S3-compatible endpoint
S3_BUCKET=personel-kartezya         # Bucket name
S3_REGION=eu-central-003            # Region (optional for some providers)
S3_BASE_PATH=documents              # Base path prefix in bucket (e.g., "documents", "hr/attachments")
S3_ACCESS_KEY=003298707e38d160000000003  # Access key ID
S3_SECRET_KEY=K00313MKPQU0ShnofhHTBntZJYwEAVc  # Secret access key

# Backblaze B2 Example (S3-compatible)
# STORAGE_PROVIDER=backblaze
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_BUCKET=kartezya-hr-documents
# S3_REGION=eu-central-003
# S3_BASE_PATH=hr/documents          # Files will be stored as: hr/documents/{uuid}.{ext}
# S3_ACCESS_KEY=003298707e38d160000000003
# S3_SECRET_KEY=K00313MKPQU0ShnofhHTBntZJYwEAVc

# AWS S3 Example
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=                        # Leave empty for AWS S3 (uses default)
# S3_BUCKET=kartezya-hr-documents
# S3_REGION=eu-central-1
# S3_BASE_PATH=attachments           # Files will be stored as: attachments/{uuid}.{ext}
# S3_ACCESS_KEY=your-aws-access-key
# S3_SECRET_KEY=your-aws-secret-key

# Azure Blob Configuration (if using Azure storage provider)
# AZURE_ACCOUNT=kartezya
# AZURE_CONTAINER=documents
# AZURE_ACCESS_KEY=your-azure-access-key
